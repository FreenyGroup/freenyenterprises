{% extends "layouts/base.njk" %}

{% block title %}Rental Agreement{% endblock %}

{% block content %}
<div class="page-wrapper">
  {% include "partials/topbar.njk" %}
  {% set title = "Rental Agreement" %}
  {% include "partials/page-title.njk" %}
  {% include "partials/permanents.njk" %}

  <main class="rental-agreement-section">
    <div class="container">
      <article class="rental-agreement-document">
        <header class="rental-agreement-document__header">
          <p class="rental-agreement-document__eyebrow">Freeny Enterprise LLC</p>
          <h2>Vehicle Rental Agreement</h2>
          <p>Review the rental agreement below. You may also open or download a copy for your records.</p>
          <div class="rental-agreement-document__actions">
            <a class="btn--base" href="assets/pdf/freeny-enterprise-rental-agreement.pdf" target="_blank"
              rel="noopener">Open PDF</a>
            <a class="btn--base rental-agreement-document__download"
              href="assets/pdf/freeny-enterprise-rental-agreement.pdf"
              download="Freeny-Enterprise-Rental-Agreement.pdf">Download PDF</a>
          </div>
        </header>

        <div class="rental-agreement-document__viewer">
          <iframe
            src="assets/pdf/freeny-enterprise-rental-agreement.pdf"
            title="Freeny Enterprise LLC Vehicle Rental Agreement"
            loading="lazy">
          </iframe>
          <p class="rental-agreement-document__fallback">
            If the agreement does not appear above, <a href="assets/pdf/freeny-enterprise-rental-agreement.pdf">
              open the PDF directly</a>.
          </p>
        </div>
      </article>

      <article class="rental-agreement-document">
        <header class="rental-agreement-document__header">
          <p class="rental-agreement-document__eyebrow">Freeny Group LLC</p>
          <h2>Uber Black Driver Rental Agreement</h2>
          <p>Review the agreement below. You may also open or download a copy for your records.</p>
          <div class="rental-agreement-document__actions">
            <a class="btn--base"
              href="assets/pdf/freeny-enterprise-uber-black-rental-agreement.pdf"
              target="_blank" rel="noopener">Open PDF</a>
            <a class="btn--base rental-agreement-document__download"
              href="assets/pdf/freeny-enterprise-uber-black-rental-agreement.pdf"
              download="Freeny-Group-Uber-Black-Rental-Agreement.pdf">Download PDF</a>
          </div>
        </header>

        <div class="rental-agreement-document__viewer">
          <iframe
            src="assets/pdf/freeny-enterprise-uber-black-rental-agreement.pdf"
            title="Freeny Group LLC Uber Black Driver Rental Agreement"
            loading="lazy">
          </iframe>
          <p class="rental-agreement-document__fallback">
            If the agreement does not appear above, <a href="assets/pdf/freeny-enterprise-uber-black-rental-agreement.pdf">
              open the PDF directly</a>.
          </p>
        </div>
      </article>
    </div>
  </main>

  {% include "partials/footer.njk" %}
</div>
{% endblock %}
