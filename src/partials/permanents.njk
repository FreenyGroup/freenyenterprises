<div class="permanents-wrapper">

  <a href="#" class="scrollToTop">
    <i class="las la-dot-circle"></i>
    <span>Top</span>
  </a>

  <div class="call-widget-wrapper">
    <button type="button" class="call-widget-btn">
      <span class="num">
        <i class="icon-call-icon"></i>
        <a href="tel:{{ contact_phone1 | default('7035991585 ') }}">{{ contact_phone1 | default('703-599-1585 ') }}</a>
      </span>
      <span class="arrow"></span>
    </button>

    <div class="call-widget-form-area">
      <form class="book-form" name="contact-form-1" method="POST" data-netlify="true">
        <div class="row justify-content-center mb-20-none">

          <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 form-group">
            <label>Name</label>
            <input type="text" name="name" placeholder="Name" class="form-control">
          </div>

          <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="Email" class="form-control">
          </div>

          <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 form-group">
            <label>Phone Number</label>
            <input type="tel" name="phonenumber" placeholder="Phone Number" class="form-control">
          </div>

          <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 form-group">
            <label>Service</label>
            <select name="service[]" multiple class="form-control">
              <option value="Shuttle Service" selected>Shuttle Service</option>
              <option value="Jet Charter">Jet Charter</option>
              <option value="Car Rental">Car Rental</option>
              <option value="Travel Planning">Travel Planning</option>
            </select>
          </div>

          <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 form-group">
            <label>Comments</label>
            <input type="text" name="comments" placeholder="Comments" class="form-control">
          </div>

          <div class="col-xl-12 form-group">
            <button type="submit" class="btn--base w-100 mt-10"><i class="icon-btn-icon"></i> SEND</button>
          </div>

        </div>
      </form>
    </div>
  </div>

</div>
